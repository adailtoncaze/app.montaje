{
  "name": "montaje",
  "version": "0.1.0",
  "private": true,
  "description": "MontaJE - Padronizacao das secoes eleitorais (app da equipe + painel do cartorio)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:equipe": "npm run dev -w @montaje/equipe",
    "dev:cartorio": "npm run dev -w @montaje/cartorio",
    "build": "npm run build -w @montaje/equipe && npm run build -w @montaje/cartorio",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "supabase:start": "supabase start",
    "supabase:link": "supabase link",
    "supabase:push": "supabase db push --linked --skip-vault",
    "supabase:push:dry": "supabase db push --linked --dry-run --skip-vault",
    "supabase:types": "supabase gen types typescript --linked > packages/core/src/database.generated.ts",
    "deploy:equipe": "npm run deploy -w @montaje/equipe",
    "deploy:cartorio": "npm run deploy -w @montaje/cartorio"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "sharp@0.32.6": true,
    "sharp@0.35.5": true,
    "esbuild@0.21.5": true
  }
}
